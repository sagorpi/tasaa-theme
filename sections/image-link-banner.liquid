{%- if section.settings.variant == 'scroll' -%}
{{ 'section-image-link-scroll.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-link-scroll.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #ImageLinks-{{ section.id }} {
    --images-mobile: {{ section.settings.columns_mobile }};
    --images-tablet: {{ section.settings.columns_tablet }};
    --images-desktop: {{ section.settings.columns_desktop }};
    --gap-mobile: {{ section.settings.gap_mobile }}px;
    --gap-desktop: {{ section.settings.gap_desktop }}px;
    --image-fit: {{ section.settings.image_fit }};
    --heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<image-link-scroll id="ImageLinks-{{ section.id }}" class="image-links color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ section.settings.heading | default: 'Image links' | escape }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="image-links__heading"><span>{{ section.settings.heading | escape }}</span></h2>
  {%- endif -%}
  <div class="image-links__body">
    <ul id="ImageLinksTrack-{{ section.id }}" class="image-links__track" tabindex="0" aria-label="{{ section.settings.heading | default: 'Image links' | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.image | default: block.settings.image_tablet | default: block.settings.image_mobile
          assign mobile_image = block.settings.image_mobile | default: desktop_image
          assign tablet_image = block.settings.image_tablet | default: desktop_image
          assign link_label = block.settings.link_label | default: desktop_image.alt
          if link_label == blank
            assign link_label = 'Image ' | append: forloop.index
          endif
          assign width_mobile = 96.0 | divided_by: section.settings.columns_mobile
          assign width_tablet = 84.0 | divided_by: section.settings.columns_tablet
          assign width_desktop = 84.0 | divided_by: section.settings.columns_desktop
          capture sizes
            echo '(min-width: 990px) ' | append: width_desktop | append: 'vw, (min-width: 750px) ' | append: width_tablet | append: 'vw, ' | append: width_mobile | append: 'vw'
          endcapture
        -%}
        <li class="image-links__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" aria-label="{{ link_label | escape }}" draggable="false">{% endif %}
            <div class="image-links__media image-links__media--{{ section.settings.image_ratio }}" style="--ratio-desktop: {{ desktop_image.aspect_ratio | default: 1.8632 }}; --ratio-tablet: {{ tablet_image.aspect_ratio | default: 1.8632 }}; --ratio-mobile: {{ mobile_image.aspect_ratio | default: 1.8632 }};">
              {%- if desktop_image != blank -%}
                {% render 'slideshow-picture', desktop_image: desktop_image, mobile_image: mobile_image, tablet_image: tablet_image, first_slide: false, image_sizes: sizes %}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {% if block.settings.link != blank %}</a>{% endif %}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_arrows -%}
      <div class="image-links__controls" hidden>
        <button type="button" data-step="-1" aria-label="Previous images" aria-controls="ImageLinksTrack-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 12H4m8-8-8 8 8 8"/></svg></button>
        <button type="button" data-step="1" aria-label="Next images" aria-controls="ImageLinksTrack-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12h16m-8-8 8 8-8 8"/></svg></button>
      </div>
    {%- endif -%}
  </div>
</image-link-scroll>
{%- else -%}
{{ 'section-hero-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-image-link-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-slideshow.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} .image-link-banner__heading { font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }}; }
{%- endstyle -%}
<hero-slideshow
  data-transition="slide"
  class="hero-slideshow image-link-banner"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-autoplay-mobile="{{ section.settings.auto_rotate_mobile }}"
  data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
  data-speed-mobile="{{ section.settings.mobile_slides_speed | times: 1000 }}"
  data-swipe="{{ section.settings.enable_swipe }}"
  data-height="adapt_image"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="image-link-banner__heading"><span>{{ section.settings.heading | escape }}</span></h2>
  {%- endif -%}
  <div class="hero-slideshow__stage">
    <div id="Slider-{{ section.id }}" class="hero-slideshow__track" aria-live="off" aria-atomic="false">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.image | default: block.settings.image_tablet | default: block.settings.image_mobile
          assign mobile_image = block.settings.image_mobile | default: desktop_image
          assign tablet_image = block.settings.image_tablet | default: desktop_image
          assign slide_label = block.settings.link_label | strip_html | default: desktop_image.alt
          if slide_label == blank
            assign slide_label = 'sections.slideshow.slide' | t | append: ' ' | append: forloop.index
          endif
          assign image_sizes = '(min-width: 750px) 84vw, 96vw'
        -%}
        <div
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          class="hero-slideshow__slide{% if forloop.first %} is-active{% endif %}"
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
          style="--hero-ratio-desktop: {{ desktop_image.aspect_ratio | default: 3.84 }}; --hero-ratio-tablet: {{ tablet_image.aspect_ratio | default: 3.84 }}; --hero-ratio-mobile: {{ mobile_image.aspect_ratio | default: 1.7142857 }}; --hero-focus-desktop: {{ desktop_image.presentation.focal_point | default: '50% 50%' }}; --hero-focus-tablet: {{ tablet_image.presentation.focal_point | default: '50% 50%' }}; --hero-focus-mobile: {{ mobile_image.presentation.focal_point | default: '50% 50%' }}; --hero-overlay: 0;"
          {{ block.shopify_attributes }}
        >
          <div class="hero-slideshow__media">
            {%- if desktop_image != blank -%}
              {% render 'slideshow-picture', desktop_image: desktop_image, mobile_image: mobile_image, tablet_image: tablet_image, first_slide: false, image_sizes: image_sizes %}
            {%- else -%}
              {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
              {%- if placeholder_slide == 1 -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a class="hero-slideshow__slide-link" href="{{ block.settings.link }}" aria-label="{{ slide_label | escape }}" draggable="false"></a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="hero-slideshow__controls">
        {%- if section.settings.show_arrows -%}
          <button type="button" class="hero-slideshow__arrow hero-slideshow__arrow--previous" data-direction="-1" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}" aria-controls="Slider-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 12H4m8-8-8 8 8 8"/></svg></button>
          <button type="button" class="hero-slideshow__arrow hero-slideshow__arrow--next" data-direction="1" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}" aria-controls="Slider-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12h16m-8-8 8 8-8 8"/></svg></button>
        {%- endif -%}
        {%- if section.settings.show_dots -%}
          <div class="hero-slideshow__pagination hero-slideshow__pagination--dots">
            {%- for block in section.blocks -%}
              <button type="button" class="hero-slideshow__dot{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-controls="Slide-{{ section.id }}-{{ forloop.index }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" {% if forloop.first %}aria-current="true"{% endif %}><span aria-hidden="true"></span></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <button type="button" class="hero-slideshow__pause" data-pause aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}" data-label-pause="{{ 'sections.slideshow.pause_slideshow' | t }}" data-label-play="{{ 'sections.slideshow.play_slideshow' | t }}">
          <span data-pause-icon aria-hidden="true">Ⅱ</span><span data-play-icon aria-hidden="true" hidden>▶</span>
        </button>
      </div>
    {%- endif -%}
  </div>
</hero-slideshow>
{%- endif -%}

{% schema %}
{
  "name": "Image link",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        {
          "value": "slideshow",
          "label": "Slideshow"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title (optional)",
      "info": "For example, Featured in. Leave blank to hide the title."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "jost_n4"
    },
    {
      "type": "header",
      "content": "Slideshow settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when Variant is Slideshow."
    },
    {
      "type": "paragraph",
      "content": "A clickable promotional carousel. Recommended artwork: desktop 1920 \u00d7 500 px; mobile 600 \u00d7 350 px. Image height adapts to your artwork."
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_swipe",
      "label": "Enable swipe and drag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Autoplay on tablet and desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "label": "Tablet and desktop interval",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "auto_rotate_mobile",
      "label": "Autoplay on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_slides_speed",
      "label": "Mobile interval",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Accessible carousel description",
      "default": "Featured promotions"
    },
    {
      "type": "header",
      "content": "Horizontal scroll settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when Variant is Horizontal scroll. Swipe or drag to see more images; the row stops at either end."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Images visible on desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Images visible on tablet",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Images visible on mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "paragraph",
      "content": "Mobile: below 750 px. Tablet: 750\u2013989 px. Desktop: 990 px and above. Extra images scroll horizontally."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "landscape",
          "label": "Landscape / logos"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fitting",
      "options": [
        {
          "value": "contain",
          "label": "Show entire image"
        },
        {
          "value": "cover",
          "label": "Fill and crop"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Tablet and desktop gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image link",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Used on all devices unless a mobile or tablet image is selected."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Below 750 px."
        },
        {
          "type": "image_picker",
          "id": "image_tablet",
          "label": "Tablet image",
          "info": "Optional. From 750 to 989 px."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link description",
          "info": "Describe the destination for screen readers, for example Shop festive sarees."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image link",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
