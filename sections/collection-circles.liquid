{% comment %}
  Collection circles — circular "Shop by Category" buttons.
  A lightweight, Dawn-styled custom section. Each block points to a collection and
  renders its featured image as a circle with the title below. Falls back to a
  placeholder image so the section previews correctly before collections are assigned.
{% endcomment %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  /* ── Mobile carousel (< 750 px) ─────────────────────────────────────────
     Flex row with snap scrolling. Each item is exactly 20 % of the
     container so precisely 5 circles are visible at once.
     Scrollbar, arrows, and dots are all hidden.                           */
  #shopify-section-{{ section.id }} .collection-circles {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .collection-circles::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-circles-wrapper {
    padding-inline: 0;
    margin-inline: 0;
  }

  #shopify-section-{{ section.id }} .collection-circles__item {
    flex: 0 0 20%;
    min-width: 0;
    box-sizing: border-box;
    padding-inline: 0.4rem;
    scroll-snap-align: start;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .collection-circles__link {
    display: block;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .collection-circles__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .collection-circles__media img,
  #shopify-section-{{ section.id }} .collection-circles__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .collection-circles__link:hover .collection-circles__media {
    transform: translateY(-4px);
    box-shadow: 0 1.2rem 2.4rem rgba(var(--color-shadow), 0.18);
  }

  #shopify-section-{{ section.id }} .collection-circles__title {
    margin: 1.2rem 0 0;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: 0.04rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    /* Switch from mobile flex carousel back to the fluid auto-fit grid.
       overflow and snap are reset so desktop is unaffected by mobile rules. */
    #shopify-section-{{ section.id }} .collection-circles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      overflow: visible;
      scroll-snap-type: none;
      gap: clamp(1.2rem, 1.5vw, 2.4rem);
    }

    /* Reset the 0.4 rem padding added for carousel spacing.
       Clones injected by the infinite-loop script must not appear in the grid. */
    #shopify-section-{{ section.id }} .collection-circles__item {
      flex: none;
      padding-inline: 0;
    }

    #shopify-section-{{ section.id }} .collection-circles__item[data-clone] {
      display: none;
    }

    #shopify-section-{{ section.id }} .collection-circles__title {
      font-size: 1.6rem;
    }
  }

  /* ── Ultra-wide (≥ 1600 px) ─────────────────────────────────────────────
     Lift the global .page-width cap (typically 120 rem / 1200 px) for this
     section only. auto-fit + 1fr then distributes all items across the
     expanded container automatically — no column-count override needed.   */
  @media screen and (min-width: 1600px) {
    #shopify-section-{{ section.id }} .collection-circles-wrapper {
      max-width: min(90vw, 220rem);
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .collection-circles {
      gap: clamp(2rem, 1.5vw, 3.2rem);
    }

    #shopify-section-{{ section.id }} .collection-circles__title {
      font-size: clamp(1.6rem, 1.2vw, 2.4rem);
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-circles-wrapper page-width isolate section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="collection-circles-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    <ul class="collection-circles" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <li
          class="collection-circles__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <a
            href="{{ collection.url | default: routes.collections_url }}"
            class="collection-circles__link"
            {% if collection == blank %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <div class="collection-circles__media media">
              {%- if collection.featured_image -%}
                <img
                  srcset="
                    {%- if collection.featured_image.width >= 165 -%}{{ collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if collection.featured_image.width >= 330 -%}{{ collection.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                    {%- if collection.featured_image.width >= 535 -%}{{ collection.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                    {{ collection.featured_image | image_url }} {{ collection.featured_image.width }}w
                  "
                  src="{{ collection.featured_image | image_url: width: 330 }}"
                  sizes="(min-width: 1600px) 10vw, (min-width: 750px) 12vw, 20vw"
                  alt="{{ collection.featured_image.alt | escape }}"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                {{ 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="collection-circles__title">
              {%- if collection.title != blank -%}
                {{- collection.title | escape -}}
              {%- else -%}
                {{- 'onboarding.collection_title' | t -}}
              {%- endif -%}
            </p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
(function () {
  'use strict';

  var MOBILE_BREAKPOINT  = 750;
  /* How long (ms) to wait for the smooth-scroll animation to finish before
     performing the silent instant reset. Must be less than duration * 1000. */
  var SCROLL_SETTLE_MS   = 380;

  var duration = {{ section.settings.autoplay_duration }};

  /* Only active on mobile viewports with autoplay enabled */
  if (duration === 0 || window.innerWidth >= MOBILE_BREAKPOINT) return;

  var list = document.querySelector('#shopify-section-{{ section.id }} .collection-circles');
  if (!list) return;

  /* ── 1. Collect real items and build clones ──────────────────────────── */
  var realItems = Array.from(list.querySelectorAll('.collection-circles__item'));
  var total = realItems.length;
  if (total < 2) return;

  realItems.forEach(function (item) {
    var clone = item.cloneNode(true);
    /* data-clone lets the desktop CSS rule hide these nodes in the grid */
    clone.setAttribute('data-clone', '');
    /* Remove clones from keyboard/screen-reader flow */
    clone.setAttribute('aria-hidden', 'true');
    clone.querySelectorAll('a, button, [tabindex]').forEach(function (el) {
      el.setAttribute('tabindex', '-1');
    });
    list.appendChild(clone);
  });

  /* Re-query so allItems includes the clones (indices 0 … 2N-1) */
  var allItems = list.querySelectorAll('.collection-circles__item');

  /* ── 2. Autoplay with infinite-loop logic ────────────────────────────── */
  var currentIndex = 0;
  var jumping      = false; /* guard: skip interval ticks during silent reset */

  setInterval(function () {
    if (jumping) return;

    currentIndex++;

    /* Smooth-scroll forward to the next item (real or clone) */
    list.scrollTo({
      left: allItems[currentIndex].offsetLeft,
      behavior: 'smooth'
    });

    /* ── 3. Silent reset when we land on the first clone ─────────────────
       clone[0] is visually identical to real[0].  Once the smooth animation
       settles we instantly jump the scroll position back to real[0].
       The user sees no rewind because the pixels look the same.           */
    if (currentIndex >= total) {
      jumping = true;

      setTimeout(function () {
        /* Disable snap so the browser engine does not fight the instant jump */
        list.style.scrollSnapType = 'none';
        list.scrollLeft = allItems[0].offsetLeft; /* instant — no animation */

        /* Two rAF calls: first flush the scrollLeft change to the GPU,
           second re-enable snap after the frame has been painted */
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            list.style.scrollSnapType = ''; /* restore CSS value */
            currentIndex = 0;
            jumping      = false;
          });
        });
      }, SCROLL_SETTLE_MS);
    }
  }, duration * 1000);
})();
</script>

{% schema %}
{
  "name": "Collection circles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop by category",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "3",
      "label": "Number of columns on mobile"
    },
    {
      "type": "header",
      "content": "Mobile carousel"
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0,
      "label": "Mobile autoplay duration (0 = disabled)"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection circles",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
