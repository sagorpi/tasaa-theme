{{ 'section-image-link-scroll.css' | asset_url | stylesheet_tag }}
{{ 'section-testimonial-carousel.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-link-scroll.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #Testimonials-{{ section.id }} {
    --images-mobile: {{ section.settings.columns_mobile }};
    --images-tablet: {{ section.settings.columns_tablet }};
    --images-desktop: {{ section.settings.columns_desktop }};
    --gap-mobile: {{ section.settings.gap_mobile }}px;
    --gap-desktop: {{ section.settings.gap_desktop }}px;
    --heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<image-link-scroll id="Testimonials-{{ section.id }}" class="testimonials color-{{ section.settings.color_scheme }}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'Customer testimonials' | escape }}">
  {%- if section.settings.heading != blank -%}<h2 class="image-links__heading"><span>{{ section.settings.heading | escape }}</span></h2>{%- endif -%}
  <div class="image-links__body">
    <ul id="TestimonialsTrack-{{ section.id }}" class="image-links__track" tabindex="0" aria-label="Customer testimonials">
      {%- for block in section.blocks -%}
        {%- liquid
          assign review_product = block.settings.product
          assign photo = block.settings.image | default: block.settings.image_mobile
          assign photo_mobile = block.settings.image_mobile | default: photo
          assign review_text = block.settings.review | strip_html | strip
          assign word_count = review_text | split: ' ' | size
          assign product_name = block.settings.product_name | default: review_product.title
          assign modal_id = 'TestimonialQuickAdd-' | append: section.id | append: '-' | append: block.id
          assign photo_alt = photo.alt | default: block.settings.reviewer
          assign mobile_width = 96.0 | divided_by: section.settings.columns_mobile
          assign tablet_width = 84.0 | divided_by: section.settings.columns_tablet
          assign desktop_width = 84.0 | divided_by: section.settings.columns_desktop
          capture image_sizes
            echo '(min-width: 990px) ' | append: desktop_width | append: 'vw, (min-width: 750px) ' | append: tablet_width | append: 'vw, ' | append: mobile_width | append: 'vw'
          endcapture
        -%}
        <li class="image-links__item" {{ block.shopify_attributes }}>
          <article class="testimonial-card">
            {%- capture photo_markup -%}
              <div class="testimonial-card__photo">
                {%- if photo != blank -%}
                  <picture>
                    {%- if photo_mobile != photo -%}<source media="(max-width: 749px)" srcset="{{ photo_mobile | image_url: width: 600 }}">{%- endif -%}
                    {{ photo | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '200, 330, 535, 750, 1000', sizes: image_sizes, alt: photo_alt }}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- endcapture -%}
            {%- if review_product != blank and section.settings.enable_quick_view -%}
              <modal-opener data-modal="#{{ modal_id }}">
                <button type="button" class="testimonial-card__open" aria-haspopup="dialog" aria-label="View {{ review_product.title | escape }}" data-product-url="{{ review_product.url }}">
                  {{ photo_markup }}
                  {% render 'loading-spinner' %}
                </button>
              </modal-opener>
            {%- elsif review_product != blank -%}
              <a href="{{ review_product.url }}" aria-label="View {{ review_product.title | escape }}" draggable="false">{{ photo_markup }}</a>
            {%- else -%}
              {{ photo_markup }}
            {%- endif -%}
            <div class="testimonial-card__review">
              {%- if word_count > section.settings.excerpt_words -%}
                <details class="testimonial-card__details">
                  <summary><span class="testimonial-card__excerpt">{{ review_text | truncatewords: section.settings.excerpt_words }} </span><span class="testimonial-card__more">read more</span><span class="testimonial-card__less">read less</span></summary>
                  <div class="rte">{{ block.settings.review }}</div>
                </details>
              {%- else -%}<div class="rte">{{ block.settings.review }}</div>{%- endif -%}
            </div>
            <div class="testimonial-card__meta">
              {%- if block.settings.reviewer != blank -%}<span class="testimonial-card__reviewer">{{ block.settings.reviewer | escape }}</span>{%- endif -%}
              {%- if block.settings.date != blank -%}<span class="testimonial-card__date">{{ block.settings.date | escape }}</span>{%- endif -%}
            </div>
            {%- if product_name != blank -%}
              <div class="testimonial-card__product">{% if review_product != blank %}<a href="{{ review_product.url }}">{{ product_name | escape }}</a>{% else %}{{ product_name | escape }}{% endif %}</div>
            {%- endif -%}
            {%- if block.settings.rating > 0 -%}
              <div class="testimonial-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for star in (1..block.settings.rating) -%}<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24"><path fill="currentColor" d="m12 1 3.4 6.9 7.6 1.1-5.5 5.4 1.3 7.6-6.8-3.6L5.2 22l1.3-7.6L1 9l7.6-1.1Z"/></svg>{%- endfor -%}
              </div>
            {%- endif -%}
          </article>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_arrows -%}
      <div class="image-links__controls" hidden>
        <button type="button" data-step="-1" aria-label="Previous testimonials" aria-controls="TestimonialsTrack-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 12H4m8-8-8 8 8 8"/></svg></button>
        <button type="button" data-step="1" aria-label="Next testimonials" aria-controls="TestimonialsTrack-{{ section.id }}"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 12h16m-8-8 8 8-8 8"/></svg></button>
      </div>
    {%- endif -%}
  </div>
</image-link-scroll>
{%- if section.settings.enable_quick_view -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.product != blank -%}
      <quick-add-modal id="TestimonialQuickAdd-{{ section.id }}-{{ block.id }}" class="quick-add-modal">
        <div role="dialog" aria-label="{{ block.settings.product.title | escape }}" aria-modal="true" class="quick-add-modal__content global-settings-popup" tabindex="-1">
          <button id="ModalClose-Testimonial-{{ section.id }}-{{ block.id }}" type="button" class="quick-add-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
          <div id="QuickAddInfo-Testimonial-{{ section.id }}-{{ block.id }}" class="quick-add-modal__content-info"></div>
        </div>
      </quick-add-modal>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "Testimonial carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title (optional)",
      "default": "Customer testimonials"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "jost_n4"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards visible on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Cards visible on tablet",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards visible on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "Open product quick view from photo",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Words before read more",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Tablet and desktop gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile photo (optional)"
        },
        {
          "type": "richtext",
          "id": "review",
          "label": "Review",
          "default": "<p>Sample testimonial \u2014 replace this text with a real customer review before publishing.</p>"
        },
        {
          "type": "text",
          "id": "reviewer",
          "label": "Customer name",
          "default": "Sample customer"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review date"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating (0 hides stars)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "product",
          "id": "product",
          "label": "Reviewed product"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name override (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial carousel",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
