{% comment %}Local SVG defaults; an optional uploaded image replaces each icon without an icon library.{% endcomment %}
{% if image != blank %}
  {{ image | image_url: width: 64 | image_tag: width: 24, height: 24, loading: 'lazy', alt: '' }}
{% else %}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {% case icon %}
      {% when 'cart-plus' %}<path d="M2 3h3l2.5 12h11l2-7H8M8 15l-1 3h12M16 2v6M13 5h6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/>
      {% when 'bag-plus' %}<path d="M11 21H5a2 2 0 0 1-2-2V7h14v4M7 8V5a3 3 0 0 1 6 0v3"/><circle cx="18" cy="17" r="5"/><path d="M18 14.5v5M15.5 17h5"/>
      {% when 'account' %}<circle cx="12" cy="8" r="3.25"/><path d="M5.75 20c.7-3 3-4.5 6.25-4.5s5.5 1.5 6.25 4.5"/>
      {% when 'categories' %}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
      {% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
      {% when 'new' %}<path d="m10 3 1.8 5.2L17 10l-5.2 1.8L10 17l-1.8-5.2L3 10l5.2-1.8L10 3Zm8 11 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z"/>
      {% when 'back' %}<path d="m14 5-7 7 7 7M7 12h15"/>
      {% when 'close' %}<path d="m5 5 14 14M5 19 19 5"/>
      {% else %}<path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {% endcase %}
  </svg>
{% endif %}
