{%- liquid
  assign similar_products = product.metafields.custom.similar_products.value | default: block.settings.similar_products
  assign similar_count = 0
  for item in similar_products
    if item.id != product.id
      assign similar_count = similar_count | plus: 1
    endif
  endfor
  assign track_id = 'SimilarProducts-' | append: section.id
-%}
{%- if block.settings.show_similar_products and similar_count > 0 -%}
  <details class="tasaa-product-information__item tasaa-similar-products" {% if block.settings.similar_open %}open{% endif %}>
    <summary><span>{{ block.settings.similar_heading | escape }}</span><svg class="tasaa-similar-products__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 10L8 5L13 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
    <div class="tasaa-similar-products__content featured-collection" style="--featured-font: var(--product-title-font); --carousel-columns: 2; --carousel-mobile: 2; --carousel-gap: 12px;">
      <div class="tasaa-similar-products__scroller">
        <ul id="{{ track_id }}" class="product-grid tasaa-product-carousel__track" data-carousel-track role="list" aria-label="{{ block.settings.similar_heading | escape }}" tabindex="0">
          {%- for item in similar_products -%}
            {%- unless item.id == product.id -%}
              <li class="grid__item tasaa-similar-products__card"{% unless item.available %} data-sold-out{% endunless %}>
                {%- if item.compare_at_price > item.price -%}
                  {%- assign discount_percent = item.compare_at_price | minus: item.price | times: 100.0 | divided_by: item.compare_at_price | round -%}
                  <span class="tasaa-similar-products__discount">{{ discount_percent }}% OFF</span>
                {%- endif -%}
                {% render 'card-product', card_product: item, media_aspect_ratio: 'portrait', featured_card: true, show_secondary_image: true, skip_styles: true, section_id: track_id %}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </details>
{%- elsif request.design_mode and block.settings.show_similar_products -%}
  <p class="tasaa-product-information__help">Similar Products: select products in this block or fill the custom.similar_products product-list metafield.</p>
{%- endif -%}
