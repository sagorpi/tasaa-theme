{% comment %}
  Optional decorative image matched to a main drawer menu label.
{% endcomment %}
{%- assign menu_label = menu_link.title | strip | downcase -%}
{%- for icon_block in blocks -%}
  {%- if icon_block.type == 'mobile_menu_icon' and icon_block.settings.image != blank -%}
    {%- assign icon_label = icon_block.settings.menu_label | strip | downcase -%}
    {%- if icon_label == menu_label -%}
      <span class="mobile-menu-icon" style="--menu-icon-size: {{ icon_block.settings.size }}px" aria-hidden="true" {{ icon_block.shopify_attributes }}>
        {{- icon_block.settings.image | image_url: width: 96 | image_tag: widths: '32, 40, 48, 64, 96', sizes: '32px', alt: '', loading: 'lazy' -}}
      </span>
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
