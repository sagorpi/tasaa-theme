{% comment %}Non-modal add-to-cart confirmation. Cart contents remain available from the cart link.{% endcomment %}
<cart-notification>
  <div id="cart-notification" class="cart-notification" aria-hidden="true" inert hidden>
    <div class="cart-notification__content">
      <a class="cart-notification__message" href="{{ routes.cart_url }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.667 5.833 7.5 15 3.333 10.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Added to cart!</span>
      </a>
      <button type="button" class="cart-notification__close" aria-label="Close notification"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m12 4-8 8m0-8 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </div>
    <div class="cart-notification__progress" aria-hidden="true"><div class="cart-notification__progress-bar"></div></div>
  </div>
  <span class="visually-hidden" role="status" aria-live="polite" data-cart-announcement></span>
</cart-notification>
